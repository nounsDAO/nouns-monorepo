# Safe by default. Set to true in Netlify and create a new production deploy to activate.
PROPOSAL_X_ENABLED="false"

# Optional override. By default, the function reuses the Nouns site's VITE_MAINNET_SUBGRAPH.
NOUNS_SUBGRAPH_URL=""

# OAuth 1.0a user-context credentials for the X account that will publish posts.
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""
X_EXPECTED_USERNAME="nounsdao"

# Optional query tuning.
SUBGRAPH_PAGE_SIZE="100"
